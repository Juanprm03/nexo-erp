# Copia este archivo a .env y ajusta los valores. Nunca commitees .env real.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Bogota
DJANGO_LOG_LEVEL=INFO

# Formato: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://nexoerp:nexoerp@db:5432/nexoerp

POSTGRES_DB=nexoerp
POSTGRES_USER=nexoerp
POSTGRES_PASSWORD=nexoerp
